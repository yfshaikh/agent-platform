# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=        # https://openrouter.ai/keys
SERPAPI_API_KEY=           # https://serpapi.com/manage-api-key
NESSIE_API_KEY=            # http://api.nessieisreal.com (sign in, copy your key)
CARTESIA_API_KEY=          # https://play.cartesia.ai (voice dock and on-call calls)
# On-call phone calls (optional): a Cartesia number and pager agent, see README "On-call phone calls"
CARTESIA_PAGER_AGENT_ID=   # agent_...
CARTESIA_FROM_NUMBER_ID=   # ap_...
ONCALL_PHONE=              # the on-call engineer's number, e.g. +15125550123